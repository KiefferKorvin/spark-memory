# Clinical SPARK deployment (docs/CLINICAL.md). Copy to .env.clinical (git- and docker-ignored), then:
#   docker compose --env-file .env.clinical -f compose.clinical.yaml up -d --build

# synthetic: fictional or de-identified test data only. real: patient data; every model host must then be listed in
# CLINICAL_COMPLIANT_HOSTS (hosts under a data processing agreement for health data) and openrouter.ai is refused.
CLINICAL_DATA_MODE=synthetic
CLINICAL_COMPLIANT_HOSTS=

# Required: every request carries "Authorization: Bearer <token>".
MEMORY_API_TOKEN=
NEO4J_PASSWORD=

# Host path of the SNOMED CT SQLite: python -m graph_memory.clinical build-terminology <RF2 snapshot ZIP> <out.sqlite>
SNOMED_TERMINOLOGY=

# Any OpenAI-compatible endpoints (chat completions with JSON schema output; embeddings with "dimensions").
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EXTRACTION_MODEL=z-ai/glm-5.3-flash
ANSWER_MODEL=z-ai/glm-5.3-flash
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024
# Merged into chat requests. On OpenRouter, pin the cheap GLM endpoints (throughput routing costs ~3.3x).
MODEL_OPTIONS={"provider":{"order":["InferenceNet","DeepInfra"],"allow_fallbacks":false,"require_parameters":true},"reasoning":{"effort":"minimal","exclude":true}}

# Optional tuning (defaults shown)
# HEADER_CODES=2160-0,33914-3,62238-1,98979-8,29463-7,2823-3
# SNOMED_LEVELS=3
# SNOMED_MIN_DEPTH=4
# ENCOUNTER_HOURS=12
