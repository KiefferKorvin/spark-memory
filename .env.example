MEMORY_MODE=live
OPENROUTER_API_KEY=
SEMANTIC_MODEL=z-ai/glm-5.3-flash
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Vector indexes keep their dimension: after a change, run python -m graph_memory.migrate (paid).
EMBEDDING_DIMENSIONS=4096
NAVIGATION_MODEL=typesafe/jev-1.13
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Local SKOS file/directory; imported at startup without model calls.
UNESCO_THESAURUS_PATH=C:/code/terminologies/UNESCO-thesaurus-2026
UNESCO_LABEL_LANGUAGE=fr
UNESCO_REQUIRED=true
TAXONOMY_MATCH_THRESHOLD=0.75
# From here up to TAXONOMY_MATCH_THRESHOLD, a new concept with valid parents is linked provisionally for review.
TAXONOMY_PROVISIONAL_THRESHOLD=0.5
# Comma separated, exact hostnames; empty disables arbitrary URL ingestion.
ALLOWED_SOURCE_HOSTS=en.wikipedia.org
# Online fallbacks for gaps in memory: wikipedia, pubmed, web (DuckDuckGo). Empty disables.
EXTERNAL_RETRIEVERS=wikipedia,pubmed,web
PAKT_WEB_BROWSER=obscura
PAKT_OBSCURA_COMMAND=
MAX_EXTERNAL_SOURCES=6
# Search memory: a need searched online within this many days is not searched again (0 disables) when its content
# words match or its embedding is at least this similar (live paraphrases 0.94-0.99, distinct topics <= 0.924).
SEARCH_MEMORY_DAYS=30
SEARCH_MEMORY_SIMILARITY=0.94
# Query records and traces older than this are deleted (0 keeps them); usage records stay.
TRACE_RETENTION_DAYS=30
# Episodes: a question asked again within this many hours (0 disables) reuses the earlier result unless memory changed.
EPISODE_REUSE_HOURS=24
EPISODE_SIMILARITY=0.94
EPISODE_RETENTION_DAYS=365
# Retrieval know-how: skip web hosts never accepted nor used after this many found sources (0 disables).
HOST_MIN_TRIALS=5
# JSON merged into chat requests (provider routing, reasoning). Default shown.
# OPENROUTER_OPTIONS={"provider":{"sort":"throughput","require_parameters":true},"reasoning":{"effort":"minimal","exclude":true}}
# Optional shared bearer token. The unauthenticated default is local-only.
MEMORY_API_TOKEN=
CANDIDATE_LIMIT=20
# Opening tokens of retrievable leaves shown to Jev; shortened automatically if a request would not fit.
NAVIGATION_EXCERPT_TOKENS=80
MAX_PARALLEL_BRANCHES=6
# Includes discovery, ingestion, indexing and retrieval of external sources.
QUERY_TIMEOUT_SECONDS=600
MAX_CHILDREN_PER_DECISION=3
# Root decisions choose a need's entry points among CANDIDATE_LIMIT index hits, so they may take more;
# if the policy prunes them all, the MIN_ROOT_CHILDREN top-ranked ones are explored anyway (0 disables).
MAX_ROOT_CHILDREN=8
MIN_ROOT_CHILDREN=2
MAX_DEPTH=10
MAX_TOTAL_NODES_EXPLORED=60
SMALL_DOCUMENT_TOKEN_THRESHOLD=500
TARGET_CHUNK_TOKENS=600
MAX_CHUNK_TOKENS=900
CONTEXT_TOKEN_BUDGET=20000
ENRICHMENT_ENABLED=true
ENRICHMENT_POLICY=on_demand
SYNTHESIS_MODEL=z-ai/glm-5.3-flash
# Answer length cap in words (0: none). Benchmarks use one cap for every compared system.
ANSWER_MAX_WORDS=0
PRIMARY_ONTOLOGY=UNESCO
PUBLIC_WEB_ENABLED=true
# On PAKT's server (PAKT's DEPLOY.md), every docker compose command here uses these files:
# COMPOSE_FILE=compose.yaml:compose.pakt.yaml:compose.vps.yaml
# Server sizing, read by compose.vps.yaml only (caps; Neo4j heap + page cache must fit under NEO4J_MEM).
NEO4J_HEAP=1g
NEO4J_PAGECACHE=1g
NEO4J_MEM=3g
MEMORY_API_MEM=2g
