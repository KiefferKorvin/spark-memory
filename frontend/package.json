{
  "name": "graph-memory-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:pakt": "tsc --noEmit && vite build --config vite.pakt.config.ts",
    "test": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --outDir .test-build --skipLibCheck src/state.ts src/state.test.ts && node --test .test-build/state.test.js"
  },
  "dependencies": {
    "@neo4j-nvl/base": "1.2.2",
    "@neo4j-nvl/react": "1.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^6.1.0"
  },
  "overrides": {
    "js-cookie": "^3.0.6"
  }
}
